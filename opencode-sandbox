#!/bin/bash
set -euo pipefail

VERSION="0.1.0"
IMAGE="ghcr.io/qwercik/opencode-sandbox"
SCRIPT_URL="https://raw.githubusercontent.com/qwercik/opencode-sandbox/master/opencode-sandbox"
CACHE_DIR="$HOME/.cache/opencode-sandbox"
SANDBOX_CONFIG="$HOME/.config/opencode-sandbox"
PROJECT_NAME=$(basename "$PWD")
PROJECT_MOUNT="/project/$PROJECT_NAME"

CHAT_WORKSPACE=""
if [ "$PWD" = "$HOME" ]; then
  CHAT_BASE="$HOME/.local/share/opencode-sandbox/chats"
  mkdir -p "$CHAT_BASE"
  CHAT_ID="chat-$(date +%Y-%m-%d_%H-%M-%S)"
  CHAT_DIR="$CHAT_BASE/$CHAT_ID"
  mkdir -p "$CHAT_DIR"
  CHAT_WORKSPACE="$CHAT_DIR"
  PROJECT_NAME="$CHAT_ID"
  PROJECT_MOUNT="/project/$CHAT_ID"
fi

# --- data directories ---

SANDBOX_DATA="$HOME/.local/share/opencode-sandbox"
mkdir -p "$SANDBOX_DATA"

SANDBOX_XDG_DATA="$SANDBOX_DATA/xdg-data"
mkdir -p "$SANDBOX_XDG_DATA"

SANDBOX_STATE="$HOME/.local/state/opencode-sandbox"
mkdir -p "$SANDBOX_STATE"

PROJECT_SLUG=$(echo "$PWD" | md5sum | cut -c1-12)
PER_PROJECT_DIR="$SANDBOX_DATA/data/$PROJECT_SLUG"
mkdir -p "$PER_PROJECT_DIR"

AUTH_FILE="$SANDBOX_DATA/auth.json"
touch "$AUTH_FILE"
chmod 600 "$AUTH_FILE"

# --- pre-flight: check for uncommitted opencode config changes ---

if [ -d "$SANDBOX_CONFIG/.git" ]; then
  if ! git -C "$SANDBOX_CONFIG" diff --cached --quiet 2>/dev/null; then
    echo "ERROR: Uncommitted staged changes in $SANDBOX_CONFIG" >&2
    echo "  Commit or stash them before starting the sandbox." >&2
    exit 1
  fi
  if ! git -C "$SANDBOX_CONFIG" diff --quiet 2>/dev/null; then
    echo "ERROR: Uncommitted unstaged changes in $SANDBOX_CONFIG" >&2
    echo "  Commit or stash them before starting the sandbox." >&2
    exit 1
  fi
  if [ -n "$(git -C "$SANDBOX_CONFIG" status --porcelain 2>/dev/null)" ]; then
    echo "ERROR: Untracked or uncommitted changes in $SANDBOX_CONFIG" >&2
    echo "  Commit or stash them before starting the sandbox." >&2
    exit 1
  fi
fi

pull_image() {
  docker pull "$IMAGE:latest" 2>/dev/null || {
    echo "-> Failed to pull image. Check your connection." >&2
    exit 1
  }
}

# --- script flags ---

if [ "${1:-}" = "--update" ]; then
  pull_image
  echo "-> Done." >&2
  exit 0
fi

if [ "${1:-}" = "--version" ]; then
  echo "opencode-sandbox $VERSION"
  exit 0
fi

# --- daily version check ---

check_versions() {
  mkdir -p "$CACHE_DIR"
  local cache_file="$CACHE_DIR/last-check"

  local now
  now=$(date +%s)
  local last_check=0
  if [ -f "$cache_file" ]; then
    last_check=$(cat "$cache_file")
  fi

  if [ $((now - last_check)) -lt 86400 ]; then
    return
  fi

  local oc_latest oc_current script_latest

  local gh_url="https://api.github.com/repos/anomalyco/opencode/releases/latest"
  local sed_pat='s/.*"tag_name": *"v\([^"]*\)".*/\1/p'
  oc_latest=$(curl -sS "$gh_url" | sed -n "$sed_pat" 2>/dev/null || true)
  oc_latest=$(echo "$oc_latest" | grep -Ex '[0-9]+\.[0-9]+\.[0-9]+' || true)
  oc_current=$(docker image inspect "$IMAGE:latest" \
    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
    2>/dev/null | sed 's/^v//' || true)

  if [ -n "$oc_latest" ] && [ -n "$oc_current" ] && [ "$oc_latest" != "$oc_current" ]; then
    echo "-> New opencode version: $oc_latest (image has $oc_current)"
    echo "  Update: opencode-sandbox --update"
  fi

  script_latest=$(curl -sS "$SCRIPT_URL" | sed -n 's/^VERSION="\(.*\)"/\1/p' 2>/dev/null || true)
  script_latest=$(echo "$script_latest" | grep -Ex '[0-9]+\.[0-9]+\.[0-9]+' || true)

  if [ -n "$script_latest" ] && [ "$script_latest" != "$VERSION" ]; then
    echo "-> New opencode-sandbox script: $script_latest (yours: $VERSION)"
    echo "  Download: curl -sSL $SCRIPT_URL -o"
    echo "    ~/.local/bin/opencode-sandbox && chmod +x ~/.local/bin/opencode-sandbox"
  fi

  echo "$now" > "$cache_file"
}

if [ "${1:-}" = "--cleanup" ]; then
  docker network prune --force --filter name=opencode- >/dev/null 2>&1 || true
  echo "-> Done." >&2
  exit 0
fi

# --- initialize sandbox config ---

mkdir -p "$SANDBOX_CONFIG"

# --- .env.agent ---

# Variables are passed to the container via --env-file only. Nothing from
# .env.agent is ever exported into this script's environment: the file comes
# from the project directory, so a hostile repo could otherwise override PATH
# and hijack the docker/curl calls below.

ENV_AGENT_FLAGS=()
TMP_ENV=""
if [ -f "$PWD/.env.agent" ]; then
  TMP_ENV=$(mktemp) && chmod 600 "$TMP_ENV"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "#"*|'') continue ;;
    esac
    case "${line%%=*}" in
      PATH|IFS|ENV|BASH_ENV|SHELLOPTS|BASHOPTS|PS4|LD_*|BASH_FUNC_*)
        echo "-> Refusing unsafe .env.agent variable: ${line%%=*}" >&2
        continue ;;
    esac
    case "$line" in
      SANDBOX_NETWORK=*) SANDBOX_NETWORK="${line#*=}" ; printf '%s\n' "$line" >> "$TMP_ENV" ;;
      [A-Z_][A-Z0-9_]*=*) printf '%s\n' "$line" >> "$TMP_ENV" ;;
      *) echo "-> Skipping invalid .env.agent line: $line" >&2 ;;
    esac
  done < "$PWD/.env.agent"
  if [ -s "$TMP_ENV" ]; then
    ENV_AGENT_FLAGS=(--env-file "$TMP_ENV")
  else
    rm -f "$TMP_ENV"
    TMP_ENV=""
  fi
fi

# --- sieć: SANDBOX_NETWORK z .env.agent ---

DOCKER_NET_ARGS=()
if [ -n "${SANDBOX_NETWORK:-}" ]; then
  DOCKER_NET_ARGS=(--network "$SANDBOX_NETWORK")
fi

# --- resolve symlinks ---

EXTRA_MOUNTS=()
shopt -s nullglob
for entry in "$PWD"/*; do
  [ -L "$entry" ] || continue
  target=$(readlink -qe "$entry") || continue
  case "$target" in
    /etc/*|/proc/*|/sys/*|/dev/*|/boot/*|/lib/*|/usr/*|/bin/*|/sbin/*|/root)
      echo "-> Skipping $entry -> $target (system path)" >&2
      continue ;;
  esac
  EXTRA_MOUNTS+=(-v "$target:/project/$PROJECT_NAME/$(basename "$entry")")
done
shopt -u nullglob

# --- launch ---

if ! docker image inspect "$IMAGE:latest" >/dev/null 2>&1; then
  pull_image
fi

check_versions

# --- default: TUI + embedded server on port 80 inside the container ---

if [ $# -eq 0 ]; then
  set -- --hostname 0.0.0.0 --port 80
fi

docker run -it --rm \
  "${DOCKER_NET_ARGS[@]}" \
  --label "agent-router.enabled=true" \
  --label "agent-router.name=$(basename "$PWD")" \
  --user "$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  -e HOME=/home/sandbox \
  -v "${CHAT_WORKSPACE:-$PWD}:$PROJECT_MOUNT" \
  "${EXTRA_MOUNTS[@]}" \
  -v "$SANDBOX_CONFIG:/home/sandbox/.config/opencode" \
  -v "$SANDBOX_XDG_DATA:/home/sandbox/.local/share" \
  -v "$PER_PROJECT_DIR:/home/sandbox/.local/share/opencode" \
  -v "$AUTH_FILE:/home/sandbox/.local/share/opencode/auth.json" \
  -v "$SANDBOX_STATE:/home/sandbox/.local/state" \
  "${ENV_AGENT_FLAGS[@]}" \
  --workdir "$PROJECT_MOUNT" \
  "$IMAGE:latest" "$@"

